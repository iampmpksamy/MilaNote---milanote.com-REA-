# Noteboard Homelab Edition — settings for deploy/compose/docker-compose.yml.
# Copy to .env next to the compose file and adjust. No passwords belong here: the server creates
# its own secrets on first start; the SMTP password is entered in the admin panel.

APP_NAME=Noteboard
APP_PUBLIC_URL=https://notes.6dainas.cloud
APP_PORT=8765
APP_BIND=0.0.0.0
DATA_PATH=/DATA/AppData/noteboard
TZ=Asia/Kolkata
REGISTRATION_MODE=invite
ADMIN_PATH=/admin
MAX_UPLOAD_MB=25
STORAGE_DRIVER=local
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
# S3_SECRET_KEY=   (only with STORAGE_DRIVER=s3; set it on the server, never commit it)
BACKUP_TIME=03:00
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BRAND_ACCENT=#2f6fed
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
NB_INSTANCE=noteboard
# Two small private subnets for the app networks (change if they clash with yours).
NB_SUBNET_INTERNAL=172.31.120.0/28
NB_SUBNET_WEB=172.31.120.16/28
# NOTEBOARD_SERVER_IMAGE=ghcr.io/iampmpksamy/noteboard-server:3.0.0-alpha.3
# NOTEBOARD_GATEWAY_IMAGE=ghcr.io/iampmpksamy/noteboard-gateway:3.0.0-alpha.3
