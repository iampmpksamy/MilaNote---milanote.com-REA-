{
  "name": "mobile",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/mobile",
  "tags": [
    "type:shell",
    "scope:mobile"
  ],
  "implicitDependencies": [
    "web"
  ],
  "targets": {
    "sync": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx cap sync",
        "cwd": "apps/mobile"
      }
    },
    "apk-debug": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx build web -c native",
          "cd apps/mobile && npx cap sync android",
          "cd apps/mobile/android && ./gradlew --no-daemon assembleDebug"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    }
  }
}