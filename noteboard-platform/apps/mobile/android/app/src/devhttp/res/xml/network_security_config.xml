<?xml version="1.0" encoding="utf-8"?>
<!-- Development builds made with -PnbDevHttp=true only: plain http:// to a LAN server is allowed
     (the app shows a warning). Certificates are still checked for https://. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
