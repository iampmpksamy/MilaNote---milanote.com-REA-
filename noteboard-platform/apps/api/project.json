{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["type:app", "scope:server"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "inputs": ["production", "^production", "{projectRoot}/build.mjs"],
      "cache": true,
      "options": { "command": "node apps/api/build.mjs", "cwd": "{workspaceRoot}" }
    },
    "integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": { "command": "node --test --test-concurrency=1 apps/api/integration/*.test.mjs", "cwd": "{workspaceRoot}" }
    }
  }
}
