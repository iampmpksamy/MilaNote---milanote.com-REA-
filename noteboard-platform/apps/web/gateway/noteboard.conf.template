# Noteboard gateway (rendered by the nginx image from environment values at start).
map $http_upgrade $nb_connection { default upgrade; '' close; }
map $http_x_forwarded_proto $nb_proto { default $http_x_forwarded_proto; '' $scheme; }

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    client_max_body_size ${NB_MAX_UPLOAD_MB}m;
    # Docker's own DNS, so the API is found again after it is recreated.
    resolver ${NB_RESOLVER} valid=10s ipv6=off;
    set $nb_api http://${NB_API_UPSTREAM};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The API: never cached here or by a proxy in front (Cloudflare included).
    location /api/ {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $nb_api;
    }
    location = /.well-known/noteboard.json {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass $nb_api;
    }

    # Files with a content hash in their name never change.
    location ~* "-[A-Za-z0-9]{8,}\.(js|css|woff2?)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        default_type application/manifest+json;
        try_files $uri =404;
    }
    # Hidden files are never served.
    location ~ /\. {
        return 404;
    }
    # Everything else is the single-page app (sign-in, /setup, /admin, boards).
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
