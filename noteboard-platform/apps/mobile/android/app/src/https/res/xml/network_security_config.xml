<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds: HTTPS only, system-trusted certificates only (TLS is never relaxed). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
