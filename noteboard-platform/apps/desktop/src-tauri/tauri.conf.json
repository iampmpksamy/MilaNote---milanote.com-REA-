{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noteboard",
  "version": "../../../package.json",
  "identifier": "com.pmpksamy.noteboard",
  "build": {
    "frontendDist": "../../../dist/apps/native/browser",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Noteboard",
        "width": 1360,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Noteboard",
    "shortDescription": "Visual boards on your own server",
    "longDescription": "Noteboard for Windows: notes, to-dos, links, pictures and boards, saved to your own self-hosted Noteboard server.",
    "category": "Productivity",
    "copyright": "Noteboard",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false },
      "wix": { "version": "3.0.0.5" }
    }
  }
}
